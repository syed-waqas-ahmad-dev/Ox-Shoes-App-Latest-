# ==============================================================================
# OX Shoes Pakistan - Free Stack Environment Variables (12 Keys)
# ==============================================================================

# 1. Database - MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shoes_app_db?retryWrites=true&w=majority"

# 2. Database Name
MONGODB_DB_NAME="shoes_app_db"

# 3. NextAuth Authentication Secret Key (32+ chars random string)
NEXTAUTH_SECRET="ox-shoes-super-secret-jwt-key-2026-pakistan"

# 4. NextAuth Base Canonical URL
NEXTAUTH_URL="http://localhost:3000"

# 5. Public Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 6. Admin Panel Master Access Key
ADMIN_ACCESS_KEY="ox-admin-2026-master-key"

# 7. Automated Cron Secret for Scheduled Tasks
CRON_SECRET="ox-cron-secret-token-2026"

# 8. Cloudinary Cloud Name (Product image uploads)
CLOUDINARY_CLOUD_NAME=""

# 9. Cloudinary API Key
CLOUDINARY_API_KEY=""

# 10. Cloudinary API Secret
CLOUDINARY_API_SECRET=""

# 11. Google OAuth Client ID
GOOGLE_CLIENT_ID=""

# 12. Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=""